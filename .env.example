LLM_PROVIDER=groq
LLM_API_KEY=
# Optional: comma-separated list of keys to rotate through automatically when
# one hits a rate limit or daily quota. Takes priority over LLM_API_KEY above.
# LLM_API_KEYS=key_one,key_two,key_three
LLM_MODEL=
LLM_MODE=live        # live | replay

# Retrieval + Scale layer (fact_layer/retrieval/) — optional, off by default.
RETRIEVAL_ENABLED=false
RETRIEVAL_TOP_K=50
RETRIEVAL_LEXICAL_WEIGHT=0.45
RETRIEVAL_SEMANTIC_WEIGHT=0.55
# RETRIEVAL_CHANNEL_FANOUT=100

# Adaptive retrieval: a bounded, deterministic K ladder. Retrieval starts at
# the first rung and climbs only on measured signals (too few candidates
# survived blocking, or the page came back saturated). The last rung is a hard
# ceiling — when it is reached the diagnostics report "budget_exhausted"
# rather than implying the search was exhaustive.
# RETRIEVAL_ADAPTIVE=true
# RETRIEVAL_K_LADDER=10,25,50,100
# RETRIEVAL_MAX_ROUNDS=4
# RETRIEVAL_MIN_UNBLOCKED=5
# RETRIEVAL_SATURATION_RATIO=0.9
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODE=live   # live | replay (replay never touches the network;
                      # requires the model already cached under
                      # cache/embeddings/models from a prior live run)
# EMBEDDING_MODEL_CACHE_DIR=cache/embeddings/models
# RETRIEVAL_INDEX_PATH=data/retrieval_index
